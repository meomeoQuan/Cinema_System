@using Cinema.Utility
@using Cinema_System.Areas.Admin.Controllers

@model IEnumerable<Theater>

@{
    ViewData["Title"] = "Cinema Management";
    // 1. Ép kiểu ViewBag.Admins về một kiểu collection cụ thể (IEnumerable<dynamic>)
    var adminsList = ViewBag.Admins as IEnumerable<dynamic>;
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">

            <h3 class="card-title mb-0 text-center fw-bold">Cinema Management</h3>
            <button id="addTheaterBtn" class="btn btn-primary">
                <i class=""></i> Add
            </button>

        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="tblData" class="table table-bordered table-hover table-striped">
                    <thead class="thead-light">
                        <tr>

                            <th style="width: 15%;">Name</th>
                            <th style="width: 15%;">Address</th>
                            <th style="width: 13%;">Admin</th>
                            <th style="width: 5%;">Space</th>
                            <th style="width: 11%;">Opening Time</th>
                            <th style="width: 11%;">Closing Time</th>

                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var theater in Model)
                        {

                            <tr data-id="@theater.CinemaID">
                                <td data-field="Name">@theater.Name</td>
                                <td data-field="Address">@theater.Address</td>
                                <td data-field="AdminID" data-admin-id="@theater.AdminID">
                                    @(theater.Admin != null ? theater.Admin.UserName : "Not Assigned")
                                </td>
                                <td data-field="NumberOfRooms">@theater.NumberOfRooms</td>
                                <td data-field="OpeningTime">@theater.OpeningTime</td>
                                <td data-field="ClosingTime">@theater.ClosingTime</td>
                                <td class="text-center">
                                    <div class="d-flex gap-2 justify-content-center">
                                        <a href="/Admin/Rooms/Index?cinemaId=@theater.CinemaID"
                                           class="btn btn-secondary btn-sm">
                                            Manage Room
                                        </a>
                                        @if (theater.Status == CinemaStatus.Open)
                                        {
                                            <button class="btn btn-danger btn-sm rounded-3 text-uppercase fw-semibold toggle-status-btn"
                                                    data-id="@theater.CinemaID">
                                                <i class="bi bi-lock-fill me-1"></i>CLOSE
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-primary btn-sm rounded-3 text-uppercase fw-semibold toggle-status-btn"
                                                    data-id="@theater.CinemaID">
                                                <i class="bi bi-unlock-fill me-1"></i>OPEN
                                            </button>
                                        }
                                        <button class="btn btn-primary rounded-3 text-uppercase fw-semibold btn-sm edit-btn">
                                            <i class="bi bi-pencil-square me-1"></i> Edit
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>


    <!-- Add Theater Form -->

    <div class="card shadow-sm mt-3 d-none" id="theater-form">
        <div class="card-header bg-primary text-white text-center">
            <h4 class="mb-0">Add Cinema</h4>
        </div>
        <div class="card-body">

            <form id="createCinemaForm">

                <input type="hidden" id="cinemaID">
                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <input type="text" class="form-control" id="theaterName" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Address</label>
                    <input type="text" class="form-control" id="theaterAddress" required>
                </div>
                <div class="mb-3">

                    <label class="form-label">Admin</label>
                    <select class="form-select" id="adminId" required>
                        @if (ViewBag.Admins != null && ViewBag.Admins.Count > 0)
                        {
                            @foreach (var admin in ViewBag.Admins)
                            {
                                <option value="@admin.Id">@admin.FullName</option>
                            }
                        }
                        else
                        {
                            <option value="">No admins available</option>
                        }
                    </select>
                </div>
                <div class="mb-3">

                    <label class="form-label">Space</label>
                    <input type="number" class="form-control" id="theaterRooms" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Opening Time</label>
                    <input type="time" class="form-control" id="theaterOpeningTime" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Closing Time</label>
                    <input type="time" class="form-control" id="theaterClosingTime" required>
                </div>

                <button type="submit" class="btn btn-secondary w-100">
                    <i class="bi bi-check-circle"></i> Submit
                </button>

            </form>
        </div>
    </div>
</div>

@section Scripts {

    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
    
    <script>
        // Convert the admin list from C# to a JavaScript variable for use
        var admins = @Html.Raw(Json.Serialize(adminsList?.Select(a => new { id = a.Id, fullName = a.FullName })));
        $(document).ready(function () {
            $('#tblData').DataTable({
                "pageLength": 10,
                "lengthMenu": [5, 10, 25, 50],
                "searching": true,
                "ordering": true,
                "info": true
            });

            // --- ADD NEW FORM SECTION (Your original code) ---
            $('#addTheaterBtn').click(function () {
                $('#theater-form').toggleClass('d-none');
            });

            $('#theaterRooms').on('input', function () {
                if ($(this).val() < 1) {
                    $(this).val(1);
                }
            });
            $('#createCinemaForm').submit(function(e) {
                e.preventDefault();

                // var openingTime = $('#theaterOpeningTime').val();
                // var closingTime = $('#theaterClosingTime').val();
                // if (openingTime && closingTime && openingTime >= closingTime) {
                //     toastr.error("Closing Time must be later than Opening Time.");
                //     return; //Stop the submission
                // }

                var theaterData = {
                    Name: $('#theaterName').val(),
                    Address: $('#theaterAddress').val(),
                    AdminID: $('#adminId').val(),
                    NumberOfRooms: $('#theaterRooms').val(),
                    OpeningTime: $('#theaterOpeningTime').val(),
                    ClosingTime: $('#theaterClosingTime').val(),
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                };

                // Validate required fields
                if (Object.values(theaterData).some(value => !value)) {
                    toastr.error('All fields are required.');
                    return;
                }

                $.ajax({
                    url: '/Admin/Cinemas/Create',
                    type: 'POST',
                    data: theaterData,
                    success: function (response) {
                        if (response.success) {
                            toastr.success(response.message);
                            location.reload();
                        } else {
                            toastr.error(response.message);
                        }
                    },
                    error: function (xhr) {
                        var errorMessage = xhr.responseJSON?.message || 'An error occurred while processing your request.';
                        toastr.error(errorMessage);
                    }
                });
            });


            // --- INLINE EDITING SECTION ---
            $('#tblData').on('click', '.edit-btn', function () {
                var row = $(this).closest('tr');
                var originalValues = {};

                row.find('td[data-field]').each(function () {
                    var cell = $(this);
                    var field = cell.data('field');

                    if (field === 'AdminID') {
                        originalValues[field] = cell.data('admin-id') || "";
                    } else {
                        originalValues[field] = cell.text().trim();
                    }

                    if (field === 'OpeningTime' || field === 'ClosingTime') {
                        var originalTime = cell.text().trim();
                        var timeInput = $('<input type="time" class="form-control form-control-sm" step="1" />');
                        timeInput.val(originalTime);
                        cell.html(timeInput);
                    }
                    else if (field === 'AdminID') {
                        var currentAdminId = cell.data('admin-id');
                        var select = $('<select class="form-select form-select-sm"></select>');
                        select.append($('<option>', { value: '', text: 'Not Assigned' }));
                        admins.forEach(function(admin) {
                            var option = $('<option>', { value: admin.id, text: admin.fullName });
                            if (admin.id === currentAdminId) { option.attr('selected', 'selected'); }
                            select.append(option);
                        });
                        cell.html(select);
                    } else {
                        cell.attr('contenteditable', 'true').addClass('editable');
                    }
                });

                row.data('original-values', originalValues);
                $(this).removeClass('btn-primary edit-btn').addClass('btn-success save-btn').html('<i class="bi bi-check-circle"></i> Save');
            });

            // Handle "Save" button click
            $('#tblData').on('click', '.save-btn', function () {
                var button = $(this);
                var row = button.closest('tr');
                var originalValues = row.data('original-values');
                var currentValues = { CinemaID: row.data('id') };
                var hasChanged = false;
                var validationPassed = true;

                row.find('td[data-field]').each(function () {
                    var cell = $(this);
                    var field = cell.data('field');
                    var value;

                    if (field === 'OpeningTime' || field === 'ClosingTime') {
                        value = cell.find('input[type="time"]').val();
                    } else if (field === 'AdminID') {
                        value = cell.find('select').val();
                    } else {
                        value = cell.text().trim();
                    }

                    currentValues[field] = value;
                    if (originalValues[field] != value) { hasChanged = true; }
                });

                if (!hasChanged) {
                    toastr.info("No changes were detected.");
                    revertRowToDisplayMode(row, button, originalValues);
                    return;
                }

                // --- FINAL VALIDATION ON SAVE ---
                if (!currentValues.Name) { toastr.error("Cinema name cannot be empty."); validationPassed = false; }
                if (!currentValues.Address) { toastr.error("Address cannot be empty."); validationPassed = false; }
                var numberOfRooms = parseInt(currentValues.NumberOfRooms);
                if (isNaN(numberOfRooms) || numberOfRooms < 1) { toastr.error("Space must be a number greater than 0."); validationPassed = false; }
                if (!currentValues.OpeningTime) { toastr.error("Opening Time cannot be empty."); validationPassed = false; }
                if (!currentValues.ClosingTime) { toastr.error("Closing Time cannot be empty."); validationPassed = false; }

                // --- NEW VALIDATION: Check if closing time is after opening time ---
                // if (currentValues.OpeningTime && currentValues.ClosingTime && currentValues.OpeningTime >= currentValues.ClosingTime) {
                //     toastr.error("Closing Time must be later than Opening Time.");
                //     validationPassed = false;
                // }

                if (validationPassed == false) return;


                // --- THIS IS THE CORRECTED AJAX CALL ---
                currentValues.__RequestVerificationToken = $('input[name="__RequestVerificationToken"]').val();
                $.ajax({
                    url: '/Admin/Cinemas/UpdateTheater',
                    type: 'POST',
                    // This 'data' property is crucial and was missing from the placeholder.
                    // It sends the entire object of new values to the controller.
                    data: currentValues,
                    success: function (response) {
                        if (response.success) {
                            toastr.success(response.message);
                            revertRowToDisplayMode(row, button, currentValues);
                        } else {
                            toastr.error(response.message);
                        }
                    },
                    error: function () {
                        toastr.error("An error occurred while updating.");
                    }
                });
            });

            // --- TOGGLE STATUS SECTION ---
            $('#tblData').on('click', '.toggle-status-btn', function () { 
                var button = $(this);
                var cinemaId = button.data('id');
                var isClosing = button.hasClass("btn-danger");
                var confirmMessage = isClosing ? "Are you sure you want to close this cinema?" : "Are you sure you want to open this cinema?";

                if (!confirm(confirmMessage)) return;

                $.ajax({
                    url: '/Admin/Cinemas/ToggleCinemaStatus',
                    type: 'POST',
                    data: { id: cinemaId, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                    success: function (response) {
                        if (response.success) {
                            toastr.success(response.message);
                            // Toggle button class and content
                            if (isClosing) {
                                button.removeClass('btn-danger').addClass('btn-primary')
                                      .html('<i class="bi bi-unlock-fill me-1"></i>OPEN');
                            } else {
                                button.removeClass('btn-primary').addClass('btn-danger')
                                      .html('<i class="bi bi-lock-fill me-1"></i>CLOSE');
                            }
                        } else {
                            toastr.error(response.message);
                        }
                    },
                    error: function (xhr) {
                        var errorMessage = xhr.responseJSON?.message || "An error occurred.";
                        toastr.error(errorMessage);
                    }
                });
            });
        });

        // Helper function to revert a row to display mode
        function revertRowToDisplayMode(row, button, values) {
            row.find('td[data-field]').each(function() {
                var cell = $(this);
                var field = cell.data('field');

                if (field === 'AdminID') {
                    var adminName = "Not Assigned";
                    var selectedAdmin = admins.find(a => a.id === values.AdminID);
                    if (selectedAdmin) { adminName = selectedAdmin.fullName; }
                    cell.html(adminName);
                } else {
                    cell.html(values[field]);
                    cell.removeAttr('contenteditable').removeClass('editable');
                }
            });
            button.removeClass('btn-success save-btn').addClass('btn-primary edit-btn').html('<i class="bi bi-pencil-square"></i> Edit');
            row.removeData('original-values');
        }
    </script>
}

