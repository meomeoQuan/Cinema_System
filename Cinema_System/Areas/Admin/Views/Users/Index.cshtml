@using Cinema.Utility
@using Cinema_System.Areas.Admin.Controllers
@model IEnumerable<ApplicationUser>

@{
    ViewData["Title"] = "User Management";
}

<div class="container-fluid mt-4">
    <!-- Tiêu đề bảng + nút Add -->
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h3 class="card-title mb-0 text-center fw-bold">User Management</h3>
            <button id="addUserBtn" class="btn btn-primary">Add</button>
        </div>

        <div class="card-body">
            <!-- Bảng Users -->
            <div class="table-responsive">
                <table id="tblData" class="table table-bordered table-hover table-striped">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 20%;">Name</th>
                            <th style="width: 25%;">Email</th>
                            <th style="width: 20%;">Phone number</th>
                            <th class="text-center" style="width: 15%;">Role</th>
                            <th class="text-center" style="width: 20%;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr data-id="@user.Id">
                                <td data-field="FullName">@user.FullName</td>
                                <td data-field="Email">@user.Email</td>
                                <td data-field="PhoneNumber">@user.PhoneNumber</td>
                                <td data-field="Role" class="text-center">
                                    @* Badge hiển thị màu theo role *@
                                    @{
                                        string GetBadgeClass(string role)
                                        {
                                            return role.ToLower() switch
                                            {
                                                "admin" => "bg-danger",
                                                "staff" => "bg-success",
                                                _ => "bg-secondary"
                                            };
                                        }
                                    }
                                    <span class="badge @GetBadgeClass(user.Role) text-white rounded-pill">
                                        <i class="bi bi-person-fill me-1"></i>
                                        @user.Role
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex gap-2 justify-content-center">
                                        @if (user.LockoutEnd == null || user.LockoutEnd < DateTime.Now)
                                        {
                                            <button onclick="lockUser('@user.Id', this)"
                                                    class="btn btn-danger btn-sm rounded-3 text-uppercase fw-semibold">
                                                <i class="bi bi-lock-fill me-1"></i>LOCK
                                            </button>
                                        }
                                        else
                                        {
                                            <button onclick="unlockUser('@user.Id', this)"
                                                    class="btn btn-success btn-sm rounded-3 text-uppercase fw-semibold">
                                                <i class="bi bi-unlock-fill me-1"></i>UNLOCK
                                            </button>
                                        }
                                        @if (user.Role != "Guest")
                                        {
                                            <button class="btn btn-primary btn-sm rounded-3 text-uppercase fw-semibold edit-btn">
                                                <i class="bi bi-pencil-square me-1"></i>Edit
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-primary btn-sm rounded-3 text-uppercase fw-semibold disabled opacity-50">
                                                <i class="bi bi-pencil-square me-1"></i>Edit
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        @* Nếu chưa có dữ liệu *@
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center">No users found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <!-- User Form -->
    <div class="card shadow-sm">
        <div id="user-form" class="p-0 d-none">
            <div class="card-header bg-primary text-white text-center">
                <h4 class="mb-0">Add new user</h4>
            </div>
            <div class="card-body">
                <form id="createUserForm">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" class="form-control" id="userName" placeholder="Enter Name" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" id="userEmail" placeholder="Enter Email" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Phone</label>
                        <input type="text" class="form-control" id="userPhone" placeholder="Enter Phone Number" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Role</label>
                        <select class="form-select" id="userRole" required>
                            <option value="Admin">Admin</option>
                            <option value="Staff">Staff</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-secondary w-100 mt-3">Submit</button>
                </form>
            </div>
        </div>
    </div>
</div>





@section Scripts {
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
    <script>
        // ✅ BẮT ĐẦU KHỐI DOCUMENT READY DUY NHẤT
        $(document).ready(function() {
            // Lấy danh sách Role từ ViewBag và chuyển thành biến JavaScript
            var roles = @Html.Raw(Json.Serialize(ViewBag.RolesList ?? new List<string>()));

            $('#tblData').DataTable({
                "pageLength": 10,
                "lengthMenu": [5, 10, 25, 50],
                "searching": true,
                "ordering": true,
                "info": true
            });

            // --- XỬ LÝ FORM THÊM MỚI ---
            $('#addUserBtn').click(function() {
                $('#user-form').toggleClass('d-none');
            });

            $('#createUserForm').submit(function(e) {
                e.preventDefault();
                // ... (Logic thêm mới người dùng của bạn giữ nguyên)
                var userName = $('#userName').val();
                var userEmail = $('#userEmail').val();
                var userPhone = $('#userPhone').val();
                var userRole = $('#userRole').val();

                // if (!userName.trim() || !userEmail.trim() || !userPhone.trim() || !userRole.trim()) {
                //     toastr.error('All fields are required.');
                //     return;
                // }
                // if (!/^\d{10}$/.test(userPhone)) {
                //     toastr.error('Phone number must be a 10-digit number.');
                //     return;
                // }
                $.ajax({
                    url: '/Admin/Users/Create',
                    type: 'POST',
                    data: {
                        FullName: userName, Email: userEmail, PhoneNumber: userPhone, Role: userRole,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            toastr.success(response.message);
                            location.reload();
                        } else {
                            toastr.error(response.message);
                        }
                    },
                    error: function(xhr) {
                        var errorMessage = xhr.responseJSON?.message || 'An error occurred.';
                        toastr.error(errorMessage);
                    }
                });
            });

            // --- XỬ LÝ EDIT VÀ SAVE ---
            $('#tblData').on('click', '.edit-btn', function () {
                var button = $(this);
                var row = button.closest('tr');
                var originalValues = {};

                row.find('td[data-field]').each(function () {
                    var cell = $(this);
                    var field = cell.data('field');
                    // originalValues[field] = cell.text().trim();
                    var originalText = cell.text().trim();
                    originalValues[field] = originalText;
                    if (field === 'Role') {
                        var currentRole = cell.text().trim();
                        var select = $('<select class="form-select form-select-sm"></select>');
                        roles.forEach(function(role) {
                            var option = $('<option>', { value: role, text: role });
                            if (role === currentRole) option.attr('selected', 'selected');
                            select.append(option);
                        });
                        cell.html(select);
                    } else {
                        // cell.attr('contenteditable', 'true').addClass('editable');
                        // ✅ THAY ĐỔI QUAN TRỌNG: Thay vì dùng contenteditable,
                        // chúng ta chèn một thẻ <input> có class .form-control
                        var input = $('<input type="text" class="form-control form-control-sm">');
                        input.val(originalText);
                        cell.html(input);
                    }
                });
                row.data('original-values', originalValues);
                button.removeClass('btn-primary edit-btn').addClass('btn-success save-btn');
                button.html('<i class="bi bi-check-circle me-1"></i>Save');
            });

            $('#tblData').on('click', '.save-btn', function () {
                var button = $(this);
                var row = button.closest('tr');
                var originalValues = row.data('original-values');
                var currentValues = { Id: row.data('id') };
                var hasChanged = false;
                var validationPassed = true;

                row.find('td[data-field]').each(function () {
                    var cell = $(this);
                    var field = cell.data('field');
                    // var value = field === 'Role' ? cell.find('select').val() : cell.text().trim();
                    var value = field === 'Role' ? cell.find('select').val() : cell.find('input').val().trim();
                    
                    currentValues[field] = value;
                    if (originalValues[field] != value) hasChanged = true;
                });

                // Validate side client
                if (!hasChanged) {
                    toastr.info("No changes were detected.");
                    revertRowToDisplayMode(row, originalValues);
                    return;
                }
  
                // if (!currentValues.FullName) { toastr.error("Full name cannot be empty."); validationPassed = false; }
                // if (!currentValues.Email) { toastr.error("Email cannot be empty."); validationPassed = false; }
                // if (!/^\d{10}$/.test(currentValues.PhoneNumber)) { toastr.error("Phone number must be a 10-digit number."); validationPassed = false; }
                // if (!validationPassed) return;

                $.ajax({
                    url: '/Admin/Users/SaveUserChanges',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(currentValues),
                    headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
                    success: function (response) {
                        if (response.success) {
                            toastr.success(response.message);
                            revertRowToDisplayMode(row, currentValues);
                        } else {
                            toastr.error(response.message);
                            // revertRowToDisplayMode(row, originalValues);
                        }
                    },
                    error: function () {
                        toastr.error("An error occurred during the update process..");
                        revertRowToDisplayMode(row, originalValues);
                    }
                });
            });

            // --- CÁC HÀM TRỢ GIÚP (HELPER FUNCTIONS) ---
            function revertRowToDisplayMode(row, values) {
                row.find('td[data-field]').each(function() {
                    var cell = $(this);
                    var field = cell.data('field');
                    var value = values[field];
                    if (field === 'Role') {
                        cell.html(getRoleBadgeHtml(value));
                    } else {
                        cell.html(value);
                        // cell.removeAttr('contenteditable').removeClass('editable');
                    }
                });
                var button = row.find('.save-btn');
                button.removeClass('btn-success save-btn').addClass('btn-primary edit-btn');
                button.html('<i class="bi bi-pencil-square me-1"></i>Edit');
                row.removeData('original-values');
            }

            function getRoleBadgeHtml(role) {
                var badgeClass = 'bg-secondary';
                if (role && role.toLowerCase() === 'admin') badgeClass = 'bg-danger';
                if (role && role.toLowerCase() === 'staff') badgeClass = 'bg-success';
                return `<span class="badge ${badgeClass} text-white rounded-pill"><i class="bi bi-person-fill me-1"></i> ${role}</span>`;
            }

            // Gắn các hàm lock/unlock vào đối tượng `window` để `onclick` có thể thấy và gọi được
            window.lockUser = function(userId, button) {
                if (confirm('Are you sure you want to lock this user?')) {
                    $.ajax({
                        url: '/Admin/Users/Lock/' + userId,
                        type: 'POST',
                        headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
                        success: function(response) {
                            if (response.success) {
                                toastr.success(response.message);
                                $(button).removeClass('btn-danger').addClass('btn-success')
                                       .html('<i class="bi bi-unlock-fill me-1"></i>UNLOCK')
                                       .attr('onclick', 'unlockUser(\'' + userId + '\', this)');
                            } else {
                                toastr.error(response.message);
                            }
                        },
                        error: function(xhr) {
                            var errorMessage = xhr.responseJSON?.message || 'An error occurred.';
                            toastr.error(errorMessage);
                        }
                    });
                }
            }

            window.unlockUser = function(userId, button) {
                if (confirm('Are you sure you want to unlock this user?')) {
                    $.ajax({
                        url: '/Admin/Users/Unlock/' + userId,
                        type: 'POST',
                        headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
                        success: function(response) {
                            if (response.success) {
                                toastr.success(response.message);
                                $(button).removeClass('btn-success').addClass('btn-danger')
                                       .html('<i class="bi bi-lock-fill me-1"></i>LOCK')
                                       .attr('onclick', 'lockUser(\'' + userId + '\', this)');
                            } else {
                                toastr.error(response.message);
                            }
                        },
                        error: function(xhr) {
                            var errorMessage = xhr.responseJSON?.message || 'An error occurred.';
                            toastr.error(errorMessage);
                        }
                    });
                }
            }
        });
    </script>
}
@Html.AntiForgeryToken()