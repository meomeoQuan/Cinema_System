@using Cinema.Utility
@model IEnumerable<ShowTime>

@{
    ViewData["Title"] = "Schedule Management";
    // Serialize ViewBag data for JavaScript usage
    var moviesList = ViewBag.Movies as IEnumerable<dynamic>;
    var cinemasList = ViewBag.Cinemas as IEnumerable<dynamic>;
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h3 class="card-title mb-0 fw-bold">
                <i class="bi bi-calendar-week-fill me-2"></i> Schedule Management
            </h3>
            <button id="addScheduleBtn" class="btn btn-primary">
                <i class="bi bi-plus-circle-fill me-1"></i> Add
            </button>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="tblData" class="table table-bordered table-hover table-striped">
                    <thead class="thead-light">
                        <tr>
                            <th>Title</th>
                            <th>Cinema</th>
                            <th>Room Number</th>
                            <th>Show Date</th>
                            <th>Show Time</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var showtime in Model)
                        {
                            <tr data-id="@showtime.ShowTimeID">
                                <td data-field="MovieID" data-movie-id="@showtime.MovieID">@showtime.Movie.Title</td>
                                <td data-field="CinemaID" data-cinema-id="@showtime.Room.Theater.CinemaID">@showtime.Room.Theater.Name</td>
                                <td data-field="RoomID" data-room-id="@showtime.RoomID">@showtime.Room.RoomNumber</td>
                                <td data-field="ShowDate">@showtime.ShowDate.ToString("yyyy-MM-dd")</td>
                                <td data-field="ShowTimes">@showtime.ShowTimes.ToString(@"hh\:mm")</td> <!-- THIS LINE IS FIXED -->
                                <td class="text-center">
                                    <div class="d-flex gap-2 justify-content-center">
                                        <button class="btn btn-primary btn-sm edit-btn">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Add Schedule Form -->
    <div class="card shadow-sm mt-3 d-none" id="schedule-form">
        <div class="card-header bg-primary text-white text-center">
            <h4 class="mb-0">Add New Schedule</h4>
        </div>
        <div class="card-body">
            <form id="createScheduleForm">
                <div class="mb-3">
                    <label class="form-label">Movie Title</label>
                    <select class="form-select" id="movieID" required>
                        <option value="">-- Select Movie --</option>
                        @if (moviesList != null)
                        {
                            @foreach (var movie in moviesList)
                            {
                                <option value="@movie.Id">@movie.Title</option>
                            }
                        }
                    </select>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Cinema</label>
                        <select class="form-select cinema-selector" id="cinemaID" required>
                            <option value="">-- Select Cinema --</option>
                            @if (cinemasList != null)
                            {
                                @foreach (var cinema in cinemasList)
                                {
                                    <option value="@cinema.Id">@cinema.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Room Number</label>
                        <select class="form-select room-selector" id="roomID" required>
                            <option value="">-- Select Cinema First --</option>
                        </select>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Show Date</label>
                    <input type="date" class="form-control" id="showDate" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Show Time</label>
                    <input type="time" class="form-control" id="showTimes" required>
                </div>
                <button type="submit" class="btn btn-secondary w-100 mt-3">
                    <i class="bi bi-check-circle"></i> Submit
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>

    <script>
        // Convert C# ViewBag data to JavaScript variables
        var movies = @Html.Raw(Json.Serialize(moviesList?.Select(m => new { id = m.Id, title = m.Title })));
        var cinemas = @Html.Raw(Json.Serialize(cinemasList?.Select(c => new { id = c.Id, name = c.Name })));

        $(document).ready(function () {
            $('#tblData').DataTable({
                "pageLength": 10,
                "lengthMenu": [5, 10, 25, 50],
                "searching": true,
                "ordering": true,
                "info": true
            });

            // --- ADD NEW FORM SECTION ---
            $('#addScheduleBtn').click(function () {
                $('#schedule-form').toggleClass('d-none');
            });

            // Use a delegated event handler for dynamically added elements (like in the edit row)
            $(document).on('change', '.cinema-selector', function() {
                var cinemaId = $(this).val();
                var container = $(this).closest('form, tr');
                var roomSelector = container.find('.room-selector');
                loadRooms(cinemaId, roomSelector);
            });


            $('#createScheduleForm').submit(function (e) {
                e.preventDefault();

                var scheduleData = {
                    MovieID: $('#movieID').val(),
                    RoomID: $('#roomID').val(),
                    ShowDate: $('#showDate').val(),
                    ShowTimes: $('#showTimes').val(),
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                };

                // Basic validation
                if (!scheduleData.MovieID || !scheduleData.RoomID || !scheduleData.ShowDate || !scheduleData.ShowTimes) {
                    toastr.error('All fields are required.');
                    return;
                }

                $.ajax({
                    url: '/Admin/Schedules/Create',
                    type: 'POST',
                    data: scheduleData,
                    success: function (response) {
                        if (response.success) {
                            toastr.success(response.message);
                            location.reload();
                        } else {
                            toastr.error(response.message);
                        }
                    },
                    error: function () {
                        toastr.error('An error occurred while creating the schedule.');
                    }
                });
            });


            // --- INLINE EDITING SECTION ---
            $('#tblData').on('click', '.edit-btn', function () {
                var row = $(this).closest('tr');
                var originalValues = {};

                row.find('td[data-field]').each(function () {
                    var cell = $(this);
                    var field = cell.data('field');
                    var value;

                    // Store original values before creating inputs
                    if (field === 'MovieID') value = cell.data('movie-id');
                    else if (field === 'CinemaID') value = cell.data('cinema-id');
                    else if (field === 'RoomID') value = cell.data('room-id');
                    else value = cell.text().trim();
                    originalValues[field] = value;

                    // Replace cell content with appropriate input
                    if (field === 'MovieID') {
                        var select = $('<select class="form-select form-select-sm"></select>');
                        movies.forEach(function(movie) {
                            var option = $('<option>', { value: movie.id, text: movie.title });
                            if (movie.id == value) option.attr('selected', 'selected');
                            select.append(option);
                        });
                        cell.html(select);
                    } else if (field === 'CinemaID') {
                        var select = $('<select class="form-select form-select-sm cinema-selector"></select>');
                        cinemas.forEach(function(cinema) {
                            var option = $('<option>', { value: cinema.id, text: cinema.name });
                            if (cinema.id == value) option.attr('selected', 'selected');
                            select.append(option);
                        });
                        cell.html(select);
                    } else if (field === 'RoomID') {
                        var roomSelect = $('<select class="form-select form-select-sm room-selector"></select>');
                        cell.html(roomSelect);
                        loadRooms(originalValues['CinemaID'], roomSelect, originalValues['RoomID']); // Load rooms for current cinema
                    } else if (field === 'ShowDate') {
                        var dateInput = $('<input type="date" class="form-control form-control-sm" />');
                        dateInput.val(value);
                        cell.html(dateInput);
                    } else if (field === 'ShowTimes') {
                        var timeInput = $('<input type="time" class="form-control form-control-sm" />');
                        timeInput.val(value);
                        cell.html(timeInput);
                    }
                });

                row.data('original-values', originalValues);
                $(this).removeClass('btn-primary edit-btn').addClass('btn-success save-btn').html('<i class="bi bi-check-circle"></i> Save');
            });

            // Handle "Save" button click
            $('#tblData').on('click', '.save-btn', function () {
                var button = $(this);
                var row = button.closest('tr');
                var updatedValues = { ShowTimeID: row.data('id') };

                // Collect current values from inputs
                updatedValues.MovieID = row.find('td[data-field="MovieID"] select').val();
                updatedValues.CinemaID = row.find('td[data-field="CinemaID"] select').val(); // For room loading logic
                updatedValues.RoomID = row.find('td[data-field="RoomID"] select').val();
                updatedValues.ShowDate = row.find('td[data-field="ShowDate"] input').val();
                updatedValues.ShowTimes = row.find('td[data-field="ShowTimes"] input').val();

                // Client-side validation
                if (!updatedValues.MovieID || !updatedValues.RoomID || !updatedValues.ShowDate || !updatedValues.ShowTimes) {
                    toastr.error("All fields are required.");
                    return;
                }

                updatedValues.__RequestVerificationToken = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '/Admin/Schedules/UpdateShowtime',
                    type: 'POST',
                    data: updatedValues,
                    success: function (response) {
                        if (response.success) {
                            toastr.success(response.message);
                            revertRowToDisplayMode(row, button, updatedValues);
                        } else {
                            toastr.error(response.message);
                        }
                    },
                    error: function () {
                        toastr.error("An error occurred while updating.");
                    }
                });
            });
        });

        // Helper function to load rooms into a select element
        function loadRooms(cinemaId, roomSelector, selectedRoomId = null) {
            if (!cinemaId) {
                roomSelector.html('<option value="">-- Select Cinema First --</option>');
                return;
            }

            $.ajax({
                url: '/Admin/Schedules/GetRoomsByCinema',
                type: 'GET',
                data: { cinemaId: cinemaId },
                success: function (response) {
                    roomSelector.empty();
                    if (response.success && response.rooms.length > 0) {
                        roomSelector.append('<option value="">-- Select Room --</option>');
                        response.rooms.forEach(function (room) {
                            var option = $('<option></option>').val(room.roomID).text(room.roomNumber);
                            if (room.roomID == selectedRoomId) {
                                option.attr('selected', 'selected');
                            }
                            roomSelector.append(option);
                        });
                    } else {
                        roomSelector.append('<option value="">No rooms available</option>');
                    }
                },
                error: function () {
                    toastr.error('Error loading rooms.');
                }
            });
        }

        // Helper function to revert a row back to display mode
        function revertRowToDisplayMode(row, button, values) {
            // Because fetching the room name requires an async call, the simplest
            // and most reliable way to ensure all data is correct is to reload.
            toastr.info("Reloading page to reflect all changes...");
            setTimeout(() => location.reload(), 1500);
        }
    </script>
}