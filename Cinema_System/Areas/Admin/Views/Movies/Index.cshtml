@using Cinema_System.Areas.Admin.Controllers
@model IEnumerable<Movie>

@{
    ViewData["Title"] = "Movie Management";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h3 class="card-title mb-0 text-center fw-bold">Movie Management</h3>
            <!-- Add button triggers modal -->
            <button id="addBtn" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addMovieModal">
                Add
            </button>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table id="tblData" class="table table-bordered table-hover table-striped">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 10%;">Image</th>
                            <th style="width: 15%;">Title</th>
                            <th style="width: 40%;">Synopsis</th>
                            <th style="width: 10%;">Genre</th>
                            <th style="width: 5%;">Duration</th>
                            <th style="width: 11%;">Release Date</th>
                            <th style="width: 4%;">Trailer</th>
                            <th style="width: 5%;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var movie in Model)
                        {
                            <tr>
                                <td data-id="@movie.MovieID" data-field="MovieImage" class="text-center">
                                    <img src="@movie.MovieImage" class="img-fluid rounded" style="height:60px" />
                                </td>
                                <td data-id="@movie.MovieID" data-field="Title">@movie.Title</td>
                                <td data-id="@movie.MovieID" data-field="Synopsis" class="text-center">
                                    <div class="d-flex align-items-center justify-content-center">@movie.Synopsis</div>
                                </td>
                                <td data-id="@movie.MovieID" data-field="Genre" class="text-center">@movie.Genre</td>
                                <td data-id="@movie.MovieID" data-field="Duration" class="text-center">@movie.Duration</td>
                                <td data-id="@movie.MovieID" data-field="ReleaseDate" class="text-center">
                                    @movie.ReleaseDate.ToString("dd-MM-yyyy")
                                </td>
                                <td data-id="@movie.MovieID" data-field="Trailer" class="text-center">
                                    @if (!string.IsNullOrEmpty(movie.TrailerLink))
                                    {
                                        <a href="@movie.TrailerLink" target="_blank">Watch</a>
                                    }
                                </td>
                                <td class="text-center">
                                    <button onclick="enableEdit(this)" class="btn btn-primary btn-sm">
                                        Edit
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ========== ADD MOVIE MODAL ========== -->
    <div class="modal fade" id="addMovieModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">Add New Movie</h5>
                    <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <form id="createForm">
                        <div class="mb-3">
                            <label class="form-label">Title</label>
                            <input type="text" class="form-control" id="movieTitle" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Synopsis</label>
                            <textarea class="form-control" id="movieSynopsis"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Genre</label>
                            <input type="text" class="form-control" id="movieGenre" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Duration (minutes)</label>
                            <input type="number" class="form-control" id="movieDuration" required min="1">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Release Date</label>
                            <div class="d-flex gap-2">
                                <select id="releaseDay" class="form-select"></select>
                                <select id="releaseMonth" class="form-select"></select>
                                <select id="releaseYear" class="form-select"></select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Trailer</label>
                            <input type="url" class="form-control" id="movieTrailerLink">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Movie Image URL</label>
                            <input type="url" class="form-control" id="movieImage">
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Submit</button>
                    </form>
                </div>

            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/toastr@2.1.4/toastr.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/plug-ins/1.11.5/sorting/natural.js"></script>

    <script>
        $(document).ready(function () {
            $('#tblData').DataTable({
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                searching: true,
                ordering: true,
                columnDefs: [{ type: 'natural', targets: 0 }]
            });

            initDateDropdowns('#releaseDay', '#releaseMonth', '#releaseYear');

            // Add form submit
            $('#createForm').submit(function (e) {
                e.preventDefault();
                const releaseDate = buildDateFromDropdown('#releaseDay', '#releaseMonth', '#releaseYear');
                if (!releaseDate) {
                    toastr.error('Please select a valid release date.');
                    return;
                }

                const data = {
                    Title: $('#movieTitle').val(),
                    Genre: $('#movieGenre').val(),
                    Synopsis: $('#movieSynopsis').val(),
                    TrailerLink: $('#movieTrailerLink').val(),
                    Duration: $('#movieDuration').val(),
                    ReleaseDate: releaseDate,
                    MovieImage: $('#movieImage').val()
                };

                $.ajax({
                    url: '/Admin/Movies/Create',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    headers: {
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: res => {
                        res.success ? (toastr.success(res.message), setTimeout(() => location.reload(), 1000))
                                    : toastr.error(res.message);
                    },
                    error: xhr => toastr.error(xhr.responseJSON?.message || 'Error processing request.')
                });
            });
        });

        // ================= EDIT FUNCTIONS =================
        function enableEdit(button) {
            const row = $(button).closest("tr");
            row.find("td[data-field]").each(function () {
                const field = $(this).data("field");
                const val = $(this).text().trim();
                $(this).data("original", val);

                if (field === "MovieImage") {
                    $(this).html(`<input type="text" class="form-control form-control-sm" value="${val}">`);
                } else if (field === "ReleaseDate") {
                    const [day, month, year] = val.split("-");
                    $(this).html(`
                        <div class="d-flex gap-1 justify-content-center">
                            <select class="form-select form-select-sm day"></select>
                            <select class="form-select form-select-sm month"></select>
                            <select class="form-select form-select-sm year"></select>
                        </div>
                    `);
                    const d = $(this).find(".day");
                    const m = $(this).find(".month");
                    const y = $(this).find(".year");
                    initDateDropdowns(d, m, y);
                    d.val(parseInt(day));
                    m.val(parseInt(month));
                    y.val(parseInt(year));
                    m.add(y).on("change", () => updateDaysDropdown(d, m, y));
                } else {
                    $(this).attr("contenteditable", "true").addClass("editable");
                }
            });

            $(button)
                .removeClass("btn-primary")
                .addClass("btn-success")
                .text("Save")
                .attr("onclick", "saveEdit(this)");
        }

        function saveEdit(button) {
            const row = $(button).closest("tr");
            const updates = [];

            row.find("td[data-field]").each(function () {
                const id = $(this).data("id");
                const field = $(this).data("field");
                const original = $(this).data("original");

                if (field === "MovieImage") {
                    const inputVal = $(this).find("input").val()?.trim() || original;

                    // luôn restore hình
                    $(this).html(`<img src="${inputVal}" class="img-fluid rounded" style="height:60px">`);

                    // nếu thực sự thay đổi mới push vào updates
                    if (inputVal !== original) updates.push({ id, field, value: inputVal });
                    return;
                }

                if (field === "ReleaseDate") {
                    const day = $(this).find(".day").val();
                    const month = $(this).find(".month").val();
                    const year = $(this).find(".year").val();
                    if (!day || !month || !year) return;

                    const display = `${day}-${month}-${year}`;
                    const value = `${year}-${month}-${day}`;

                    $(this).text(display); // restore hiển thị ngay
                    if (display !== original) updates.push({ id, field, value, display });
                    return;
                }

                const val = $(this).text().trim();
                if (val !== original) updates.push({ id, field, value: val });

                $(this).removeAttr("contenteditable").removeClass("editable");
            });

            // restore nút Edit
            $(button)
                .removeClass("btn-success")
                .addClass("btn-primary")
                .text("Edit")
                .attr("onclick", "enableEdit(this)");

            if (updates.length === 0) return;

            // gửi AJAX cho những thay đổi
            updates.forEach(u => {
                $.post("/Admin/Movies/UpdateField", {
                    id: u.id,
                    field: u.field,
                    value: u.value,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                })
                .done(res => {
                    if (res.success && u.field !== "MovieImage") {
                        const cell = row.find(`td[data-field="${u.field}"]`);
                        if (u.display) cell.text(u.display);
                        else cell.text(u.value);
                    }
                });
            });
        }



        // ================= DATE HELPERS =================
        function initDateDropdowns(daySel, monthSel, yearSel) {
            const d = $(daySel), m = $(monthSel), y = $(yearSel);

            d.empty().append("<option>Day</option>");
            m.empty().append("<option>Month</option>");
            y.empty().append("<option>Year</option>");

            for (let i = 1; i <= 31; i++) d.append(`<option>${i}</option>`);
            for (let i = 1; i <= 12; i++) m.append(`<option>${i}</option>`);

            const yearNow = new Date().getFullYear();
            for (let yy = yearNow; yy <= yearNow + 10; yy++) y.append(`<option>${yy}</option>`);
        }

        function updateDaysDropdown(d, m, y) {
            const month = parseInt(m.val());
            const year = parseInt(y.val());
            const days = new Date(year, month, 0).getDate();
            d.empty().append("<option>Day</option>");
            for (let i = 1; i <= days; i++) d.append(`<option>${i}</option>`);
        }

        function buildDateFromDropdown(daySel, monthSel, yearSel) {
            const day = $(daySel).val();
            const month = $(monthSel).val();
            const year = $(yearSel).val();
            if (!day || !month || !year) return null;
            return `${year}-${month.padStart(2, '0')}-${day.padStart(2, '0')}`;
        }
    </script>
}
