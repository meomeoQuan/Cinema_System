@model Cinema_System.Areas.Request.PaymentRequest

@{
    ViewData["Title"] = "Payment Summary";
}

<style>
    body {
        background: radial-gradient(circle at center, #001f3f, #000);
        color: white;
        font-family: 'Orbitron', sans-serif;
    }

    .container {
        margin-top: 50px;
    }

    /* Neon Card */
    .card {
        background: rgba(0, 0, 0, 0.85);
        border: none;
        border-radius: 15px;
        box-shadow: 0 0 15px rgba(0, 153, 255, 0.8);
        padding: 25px;
    }

    h4, h5, h6 {
        color: white;
        font-weight: bold;
    }

    /* Neon Button (used for both Back and Confirm) */
    .btn-neon {
        display: inline-block;
        background: linear-gradient(45deg, #00d4ff, #007bff);
        color: white !important;
        border: none;
        box-shadow: 0 0 15px #00d4ff;
        padding: 10px 25px;
        border-radius: 5px;
        font-weight: bold;
        text-decoration: none;
        transition: 0.3s ease-in-out;
    }

        .btn-neon:hover {
            background: #007bff;
            box-shadow: 0 0 20px #00d4ff;
        }

    .btn-neon-small {
        display: inline-block;
        background: linear-gradient(45deg, #00d4ff, #007bff);
        color: white !important;
        border: none;
        box-shadow: 0 0 15px #00d4ff;
        padding: 5px 12px;
        border-radius: 5px;
        font-weight: bold;
        text-decoration: none;
        transition: 0.3s ease-in-out;
    }

        .btn-neon-small:hover {
            background: #007bff;
            box-shadow: 0 0 20px #00d4ff;
        }

    .form-control {
        background: rgba(255, 255, 255, 0.1);
        color: white;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 5px;
        transition: 0.3s ease;
    }

        .form-control:focus {
            background: rgba(255, 255, 255, 0.2);
            border: 1px solid #00d4ff;
            box-shadow: 0 0 10px #00d4ff;
        }

    .table {
        color: white;
        border-color: rgba(255, 255, 255, 0.1);
    }

        .table th {
            background-color: rgba(255, 255, 255, 0.05);
            color: #00d4ff;
            font-weight: 600;
        }

        .table td {
            background-color: rgba(0, 0, 0, 0.3);
        }

    .text-end h5 {
        color: white;
    }

    .text-muted {
        color: #aaa !important;
    }
</style>

<div class="container">
    <!-- 🔙 Back Button Styled Like Confirm -->
    <div class="mb-4">
        <a href="/Guest/Booking/Index" class="btn btn-small">&larr; Back</a>
    </div>

    <div class="row g-4">
        <!-- LEFT: Email Input -->
        <div class="col-md-5">
            <div class="card">
                <h4 class="mb-3">Your Contact Info</h4>
                <form id="booking-form" asp-action="CreatePayment" asp-controller="Payment" asp-area="Guest" method="post">
                    <!-- Coupon -->
                    <input type="hidden" name="Coupon" value="@Model.Coupon" />

                    <!-- Total -->
                    <input type="hidden" name="TotalAmount" value="@Model.TotalAmount" />

                    <!-- Seats -->
                    @for (int i = 0; i < Model.Seats.Count; i++)
                    {
                        <input type="hidden" name="Seats[@i].nameSeat" value="@Model.Seats[i].nameSeat" />
                        <input type="hidden" name="Seats[@i].showTimeSeatId" value="@Model.Seats[i].showTimeSeatId" />
                    }

                    <!-- Items -->
                    @for (int i = 0; i < Model.Items.Count; i++)
                    {
                        <input type="hidden" name="Items[@i].name" value="@Model.Items[i].name" />
                        <input type="hidden" name="Items[@i].price" value="@Model.Items[i].price" />
                        <input type="hidden" name="Items[@i].quantity" value="@Model.Items[i].quantity" />
                    }

                    <!-- Email -->
                    <div class="mb-3">
                        <label for="email" class="form-label">Email Address</label>
                        <input type="email" class="form-control" id="email" name="Email" placeholder="Enter your email" value="@Model.Email" required />
                    </div>

                    <h5>@(Model.Email ?? "null")</h5>
                    <div class="mt-4">
                        <button type="submit" id="book-btn" class="btn-neon w-100">
                            Confirm and Pay
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- RIGHT: Summary -->
        <div class="col-md-7">
            <div class="card">
                <h4 class="mb-3">Order Summary</h4>

                <h6>Selected Seats</h6>
                <table class="table table-sm table-bordered align-middle">
                    <thead>
                        <tr>
                            <th>Seat</th>
                            <th>Showtime ID</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var seat in Model.Seats)
                        {
                            <tr>
                                <td>@seat.nameSeat</td>
                                <td>@seat.showTimeSeatId</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <h6 class="mt-4">Food & Drinks</h6>
                <table class="table table-sm table-bordered align-middle">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Qty</th>
                            <th>Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.name</td>
                                <td>@item.quantity</td>
                                <td>@item.price.ToString("N0") ₫</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="text-end mt-3">
                    <h5>Total: <span class="fw-bold">@Model.TotalAmount.ToString("N0") ₫</span></h5>
                </div>

                @if (!string.IsNullOrEmpty(Model.Coupon))
                {
                    <div class="text-end text-muted">
                        Coupon: <strong>@Model.Coupon</strong>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
