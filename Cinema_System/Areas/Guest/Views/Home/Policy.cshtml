@{
    ViewData["Title"] = "About Us";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5 text-white" style="font-family: 'Orbitron', sans-serif; max-width:800px; margin:0 auto;">

    <p style="font-size: 1.2rem; line-height: 1.8;">
        Cinema is integrated with digital tickets combined with QR codes. When you go to the cinema, please show your QR code so the staff can scan it for validation.
    </p>

    <p style="font-size: 1.2rem; line-height: 1.8;">
        If you come with a group, only one person needs to show their QR code on behalf of the group. When your group gathers enough members, show that QR code for entry.
    </p>

    <p style="font-size: 1.2rem; line-height: 1.8; color:#ff4d4d;">
        Any mistakes or issues are not the responsibility of the cinema.
    </p>
</div>
