@model IEnumerable<OrderDetail>

@{
    ViewData["Title"] = "Ticket Validation";
}

@foreach(var orderGroup in Model.GroupBy(o => o.Order))
{
    var firstOrder = orderGroup.FirstOrDefault();
    <h5>OrderId: @firstOrder.OrderID</h5>
}

@foreach(var userGroup in Model.GroupBy(o => o.Order?.User))
{
    var firstUser = userGroup.FirstOrDefault();
    var UserName = firstUser.Order.User.UserName;
    var UserEmail = firstUser.Order.User.Email;
    <h3>Customer: @(UserEmail ?? UserName)</h3>
}
  <h3>Your Ticket Include: </h3>

@foreach (var cinemaGroup in Model.GroupBy(o => o.ShowtimeSeat?.Showtime?.Room?.Theater?.Name))
{
    var firstOrder = cinemaGroup.FirstOrDefault();
    var cinemaName = cinemaGroup.Key;
    var cinemaAddress = firstOrder?.ShowtimeSeat?.Showtime?.Room?.Theater?.Address;
    <h3>@cinemaName</h3>
    <p>@cinemaAddress</p>

    // Group showtimes within this cinema only
    @foreach (var showtimeGroup in cinemaGroup.GroupBy(o => o.ShowtimeSeat?.Showtime))
    {
        var firstShowTime = showtimeGroup.FirstOrDefault();
        var showDate = firstShowTime?.ShowtimeSeat?.Showtime?.ShowDate.ToString("dd/MM/yyyy");
        var showHour = firstShowTime?.ShowtimeSeat?.Showtime?.ShowTimes;
        @if (showDate != null)
        {
            <p>Date: @showDate</p>
        }
        @if(showHour != null)
        {
            <p>Time: @showHour</p>
        }
       

        // Group movies within this showtime only
        @foreach (var movieGroup in showtimeGroup.GroupBy(o => o.ShowtimeSeat?.Showtime?.Movie?.Title))
        {
            var firstMovie = movieGroup.FirstOrDefault();
            var movieTitle = movieGroup.Key;
            var genre = firstMovie?.ShowtimeSeat?.Showtime?.Movie?.Genre;
            var duration = firstMovie?.ShowtimeSeat?.Showtime?.Movie?.Duration + " mins";
            var roomNumber = firstMovie?.ShowtimeSeat?.Showtime?.Room?.RoomNumber;

            // Seats
            var seatDetails = movieGroup.Where(d => d.ShowtimeSeat?.Seat != null);
            if (seatDetails.Any())
            {
                <h4>@movieTitle</h4>
                <p>Genre: @genre</p>
                <p>Duration: @duration</p>
                <h5>Seat Information</h5>
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Room Number</th>
                            <th>Seat Name</th>
                            <th>Ticket Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in seatDetails)
                        {
                            <tr>
                                <td>@roomNumber</td>
                                <td>@detail.ShowtimeSeat.Seat.SeatName</td>
                                <td>@($"{detail.ShowtimeSeat.Price} vnd")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            // Products
            var productDetails = movieGroup.Where(d => d.Product != null);
            if (productDetails.Any())
            {
                <h5>Product Information</h5>
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Product Name</th>
                            <th>Price</th>
                            <th>Quantity</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in productDetails)
                        {
                            <tr>
                                <td>@detail.Product?.Name</td>
                                <td>@($"{detail.Product?.Price} vnd")</td>
                                <td>@detail.Quantity</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    }
}

